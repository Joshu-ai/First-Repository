# Copy to .env.local and fill in.
NEXT_PUBLIC_BRAND_NAME=Nimbus
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=joshualef@duck.com

# 32+ random characters: openssl rand -base64 48
AUTH_SECRET=

# Comma-separated emails that become admins on sign-up (the very first account is always admin).
ADMIN_EMAILS=joshualef@duck.com

# Stripe (https://dashboard.stripe.com/apikeys). Leave empty locally to use instant test checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where the SQLite database and uploaded product files live. Use a persistent disk in production.
DATA_DIR=./data

# Separate domain for customer-hosted sites (wildcard DNS *.yourdomain -> this app). Empty = serve at /hosted/<site>/ (local testing).
HOSTING_DOMAIN=

# Custom domains (customers connect their own domain to a hosted site). Needs HOSTING_DOMAIN or CUSTOM_DOMAIN_TARGET.
# Hostname customers CNAME to. Defaults to cname.<HOSTING_DOMAIN>, which your wildcard record already covers.
CUSTOM_DOMAIN_TARGET=
# Your server's public IPv4 address(es), for root domains (example.com) that can't use a CNAME. Comma-separated.
# Defaults to whatever CUSTOM_DOMAIN_TARGET resolves to.
CUSTOM_DOMAIN_IPS=
# Other hostnames that serve this app itself, e.g. your host's default address (myapp.onrender.com). Comma-separated.
APP_HOSTS=
# Optional DNS servers for domain checks, e.g. 1.1.1.1,8.8.8.8. Empty = the server's own resolver.
DNS_SERVERS=

# Only for demos: allow free test checkout in production when Stripe isn't configured. Never set this on a live store.
ALLOW_TEST_CHECKOUT=

# Email (https://resend.com). Without a key, emails are saved to DATA_DIR/outbox instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Nimbus <hello@yourdomain.com>"
# New-sale, new-brief and customer-message alerts. Defaults to the first ADMIN_EMAILS address.
ADMIN_NOTIFY_EMAIL=joshualef@duck.com
